# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# WhatsApp Configuration
WHATSAPP_SESSION_NAME=simon-bot
WHATSAPP_HEADLESS=true
WHATSAPP_QR_TIMEOUT=60

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/simon-bot
MONGODB_DB_NAME=simon_bot
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Security
JWT_SECRET=your_super_secret_jwt_key_here_change_this
API_KEY=your_api_key_here_change_this
SESSION_SECRET=your_session_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/bot.log
LOG_MAX_SIZE=5m
LOG_MAX_FILES=5

# Feature Flags
ENABLE_AUTO_REPLY=true
ENABLE_MESSAGE_LOGGING=true
ENABLE_USER_TRACKING=false

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Pairing Settings
PAIRING_CODE_EXPIRY=300
MAX_PAIRING_ATTEMPTS=3